{
  "name": "@repo/cache-testing",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build && tsx create-instances.ts",
    "cluster:start": "pm2 start cluster.config.js --env production",
    "cluster:stop": "pm2 kill",
    "e2e": "playwright test --config=./playwright.config.ts",
    "e2e:ui": "playwright test --ui --config=./playwright.config.ts",
    "lint:check": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix --max-warnings=0",
    "playwright:install": "playwright install chromium",
    "start": "dotenv -e .env.local -v SERVER_STARTED=1 node .next/standalone/apps/cache-testing/server.js"
  },
  "dependencies": {
    "@neshca/cache-handler": "workspace:*",
    "axios": "1.10.0",
    "next": "15.4.0-canary.61",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "5.5.6"
  },
  "devDependencies": {
    "@playwright/test": "1.53.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "dotenv-cli": "8.0.0",
    "eslint": "9.30.1",
    "fastify": "5.4.0",
    "pm2": "6.0.8",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
